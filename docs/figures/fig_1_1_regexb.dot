digraph G {
  graph [rankdir=TB, fontname="SimHei", fontsize=12, nodesep=0.38, ranksep=0.42,
         margin=0.16, bgcolor="white", pad=0.15];
  node  [fontname="SimHei", fontsize=11, penwidth=1.1, color="#333333"];
  edge  [fontname="SimHei", fontsize=10, penwidth=1.1, color="#333333",
         arrowsize=0.75, labeldistance=1.7];
  entry [label="接图（a）", shape=box, style="rounded,filled", fillcolor="#E8F0FE"];
  n0 [label="按 闭包 > 连接 > 选择 的优先级转\n成逆波兰式", shape=parallelogram, style="filled", fillcolor="#EDF7ED"];
  n1 [label="得到 (规则, 后缀式) 列表，并收集全\n部字符集原子", shape=box];
  n2 [label="按“成员签名”把 256 个字节划成等价\n类，得到字符类字母表", shape=box];
  n3 [label="结束", shape=box, style="rounded,filled", fillcolor="#E8F0FE"];
  entry -> n0;
  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  graph [dpi=200];
}
