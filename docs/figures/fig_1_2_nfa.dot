digraph G {
  graph [rankdir=TB, fontname="SimHei", fontsize=12, nodesep=0.38, ranksep=0.42,
         margin=0.16, bgcolor="white", pad=0.15];
  node  [fontname="SimHei", fontsize=11, penwidth=1.1, color="#333333"];
  edge  [fontname="SimHei", fontsize=10, penwidth=1.1, color="#333333",
         arrowsize=0.75, labeldistance=1.7];
  s [label="开始", shape=box, style="rounded,filled", fillcolor="#E8F0FE"];
  a [label="建立空栈 S 与全局状态计数器 i = \n0", shape=box];
  b [label="对每条参与自动机的规则：追加其“或”于统\n一初态", shape=box];
  c [label="从左到右扫描后缀式，取当前符号 c", shape=box];
  d [label="c 是字符类原子？", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  d1 [label="新建状态 i、i+1；对类中每个字节加边\n；压入 (i, i+1)；i += 2", shape=box];
  e [label="c 是连接符 . ？", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  e1 [label="弹出 (s1,s2)、(s3,s4)；加\n边 s2→s3(ε)；压入 (s1,s4\n)", shape=box];
  f [label="c 是选择符 | ？", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  f1 [label="弹出两个片段；新建 i、i+1；四条 ε\n 边汇合两片段", shape=box];
  g [label="c 是闭包 * ？", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  g1 [label="弹出片段 (s1,s2)；新建 i、i+\n1；四条 ε 边形成回路", shape=box];
  h [label="还有符号？", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  i [label="取栈底片段 (start, accept\n)，把 accept 标为接受态\n并记录该规则的单词编码", shape=box];
  j [label="NFA 状态转换表（含 ε 边）+ 邻接\n表输出", shape=parallelogram, style="filled", fillcolor="#EDF7ED"];
  end [label="结束", shape=box, style="rounded,filled", fillcolor="#E8F0FE"];
  s -> a;
  a -> b;
  b -> c;
  c -> d;
  d -> d1 [label="是"];
  d -> e [label="否"];
  d1 -> h;
  e -> e1 [label="是"];
  e -> f [label="否"];
  e1 -> h;
  f -> f1 [label="是"];
  f -> g [label="否"];
  f1 -> h;
  g -> g1 [label="是"];
  g -> c [label="否（原子）"];
  g1 -> h;
  h -> c [label="是，继续"];
  h -> i [label="否"];
  i -> j;
  j -> end;
  graph [dpi=200];
}
