digraph G {
  graph [rankdir=TB, fontname="SimHei", fontsize=12, nodesep=0.38, ranksep=0.42,
         margin=0.16, bgcolor="white", pad=0.15];
  node  [fontname="SimHei", fontsize=11, penwidth=1.1, color="#333333"];
  edge  [fontname="SimHei", fontsize=10, penwidth=1.1, color="#333333",
         arrowsize=0.75, labeldistance=1.7];
  s [label="开始", shape=box, style="rounded,filled", fillcolor="#E8F0FE"];
  a [label="载入 BNF：左部 -> 右部1 | 右\n部2；首非终结符即开始符号", shape=parallelogram, style="filled", fillcolor="#EDF7ED"];
  b [label="自动增广：追加 S' -> S（已有则跳\n过）", shape=box];
  c [label="标记所有能推出纯终结符串的非终结符（迭代\n到不动点）", shape=box];
  d [label="删除右部含“未标记非终结符”的产生式；重\n复直到不再变化", shape=box];
  e [label="从开始符号出发，标记所有可达的非终结符", shape=box];
  f [label="删除左部不可达的产生式", shape=box];
  g [label="有规则被删除？", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  h [label="重新计算 First/Follow 所需\n的符号表", shape=box];
  i [label="化简后的文法 + 被删除规则清单（含原因\n）", shape=parallelogram, style="filled", fillcolor="#EDF7ED"];
  end [label="结束", shape=box, style="rounded,filled", fillcolor="#E8F0FE"];
  s -> a;
  a -> b;
  b -> c;
  c -> d;
  d -> e;
  e -> f;
  f -> g;
  g -> c [label="是：再化简一轮"];
  g -> h [label="否"];
  h -> i;
  i -> end;
  graph [dpi=200];
}
